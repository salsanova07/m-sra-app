# Anthropic API anahtarını buraya koy (kopyala: .env)
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL bağlantısı (zorunlu) — kalıcı konuşma geçmişi burada saklanır
DATABASE_URL=postgresql://misra:misra@localhost:5432/misra

# /admin sayfası şifresi (HTTP Basic — kullanıcı adı fark etmez)
ADMIN_PASSWORD=degistir-beni

# Geri bildirim e-posta bildirimi (Resend) — üçü de doluysa e-posta gönderilir
RESEND_API_KEY=re_...
NOTIFY_EMAIL=sen@ornek.com
# Doğrulanmış bir alan adın yoksa Resend'in test göndericisini kullan:
FEEDBACK_FROM_EMAIL=onboarding@resend.dev

# İsteğe bağlı ayarlar
CLAUDE_MODEL=claude-sonnet-5
MAX_TOKENS=4096

# Asistanın hitap ettiği kişinin adı
USER_NAME=Barış
